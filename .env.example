# ══════════════════════════════════════════════════════════════════
#  Конфигурация приложения (шаблон).
#  Скопируйте в .env и измените под себя:  cp .env.example .env
#
#  ВАЖНО: стек полностью работает БЕЗ ключей и секретов — у каждой
#  переменной есть дефолт в docker-compose.yml. Ключи (JWT_SECRET,
#  POSTGRES_PASSWORD и т.п.) можно задать своими — тогда поведение
#  остаётся тем же, просто данные будут вашими.
# ══════════════════════════════════════════════════════════════════

# ── Общее ──────────────────────────────────────────────────────────
# Имя проекта: используется как префикс volume/сети и в заголовках.
COMPOSE_PROJECT_NAME=hackat

# Окружение: dev | test | staging | prod
APP_ENV=dev

# Публичный хост, на котором крутится стек (для документации)
APP_HOST=localhost

# ── PostgreSQL ─────────────────────────────────────────────────────
POSTGRES_VERSION=16
POSTGRES_HOST=db           # имя сервиса в compose (внутри docker-сети)
POSTGRES_PORT=5432         # порт на хосте (левый)
POSTGRES_USER=user
POSTGRES_PASSWORD=password # необязательно; дефолт подходит для локальной разработки
POSTGRES_DB=appdb

# ── Backend (.NET) ────────────────────────────────────────────────
# Внутренний порт ASP.NET в контейнере 8080 (к нему привязан healthcheck)
APP_PORT=8080              # порт на хосте (левый)
# DATABASE_URL формируется автоматически из POSTGRES_* внутри compose,
# но может быть переопределён (например, для внешней БД):
# DATABASE_URL=postgres://user:password@host:5432/appdb

# Разрешённые источники для CORS через запятую
CORS_ORIGIN=http://localhost:5173

# Секрет для подписи токенов/сессий. Необязателен для запуска;
# если задаёте — используйте значение длиной >= 32 символа
# (openssl rand -hex 32), иначе дефолт для dev-режима.
JWT_SECRET=change_me_at_least_32_chars

# ── Frontend (Vite/Vue) ─────────────────────────────────────────
# Порт dev-сервера на хосте и порт опубликованного nginx
FRONTEND_PORT=5173
# Базовый URL API для браузера. Универсальный дефолт — относительный
# путь /api: в dev его проксирует Vite, в prod — nginx (см. infra/nginx).
# Можно указать абсолютный URL, если API живёт отдельно.
VITE_API_URL=/api
